PORT=8080
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
RATE_LIMIT_WRITE_MAX=60
DATABASE_URL=postgres://dev:dev@localhost/changeMe
DATABASE_SSL=auto
TOKEN_SECRET=changeMe
AUTH_DEMO_ENABLED=true
AUTH_OIDC_ENABLED=false
# Auth0/Okta/etc issuer URL (trailing slash for Auth0)
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
# Optional for confidential clients
AUTH_OIDC_CLIENT_SECRET=
# Callback URL on the API host (or Vite proxy). Must match IdP callback exactly.
AUTH_OIDC_REDIRECT_URI=http://localhost:5173/api/auth/oidc/callback
# For split deployments (Vercel SPA + Render API), set this to the SPA origin.
AUTH_FRONTEND_ORIGIN=
AUTH_POST_LOGIN_PATH=/
# Cookie signing secret (>= 16 chars). If omitted, TOKEN_SECRET must be >= 16 chars.
SESSION_SECRET=
# When split origin, usually "none" (requires HTTPS in production)
SESSION_COOKIE_SAME_SITE=lax
